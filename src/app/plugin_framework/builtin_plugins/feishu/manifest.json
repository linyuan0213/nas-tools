{
  "manifest_version": "1.0",
  "id": "feishu",
  "name": "飞书消息",
  "version": "1.0.0",
  "author": "linyuan0213",
  "author_url": "https://github.com/linyuan0213",
  "description": "飞书消息渠道，支持双向交互（长连接）与带图通知。配置方式：飞书开放平台创建企业自建应用，事件订阅选 WebSocket（长连接）模式；参数获取与消息中心配置见插件 README。",
  "category": "system",
  "tags": ["飞书", "消息", "通知", "交互"],
  "icon": "/api/plugin-framework/plugins/feishu/assets/feishu.svg",
  "color": "#3370FF",
  "min_app_version": "3.0.0",
  "backend": {
    "entry": "backend.plugin:FeishuPlugin",
    "api_prefix": "",
    "permissions": [],
    "dependencies": ["lark-oapi>=1.7.3"],
    "hooks": [
      "plugin.config_changed"
    ],
    "supports_run": true
  },
  "frontend": {
    "routes": [],
    "settings": {
      "component": "SettingsPage",
      "fields": []
    },
    "slots": []
  }
