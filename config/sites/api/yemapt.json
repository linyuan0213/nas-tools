{
  "id": "yemapt",
  "name": "YemaPT",
  "domain": "www.yemapt.org",
  "domain_aliases": [
    "yemapt.org"
  ],
  "tid_pattern": "\\d+",
  "detail_page_url": "/torrent/{tid}",
  "encoding": "UTF-8",
  "public": false,
  "api": {
    "base_url": "https://www.yemapt.org",
    "auth": {
      "type": "api_key",
      "header_name": "Authorization"
    },
    "endpoints": {
      "search": {
        "method": "POST",
        "path": "/openApi/torrent/fetchOpenTorrentList.json",
        "body": {
          "keyword": "{keyword}",
          "pageParam": {
            "current": "{page_1}",
            "pageSize": 20
          },
          "sorter": {}
        },
        "mode_mapping": {
          "MOVIE": [
            {
              "categoryId": 4
            }
          ],
          "TV": [
            {
              "categoryId": 5
            },
            {
              "categoryId": 13
            },
            {
              "categoryId": 15
            }
          ],
          "ANIME": [
            {
              "categoryId": 14
            }
          ]
        },
        "response": {
          "items_key": "data",
          "item_mapping": {
            "title": {
              "source": "showName"
            },
            "description": {
              "source": "shortDesc"
            },
            "size": {
              "source": "fileSize"
            },
            "seeders": {
              "source": "seedNum"
            },
            "leechers": {
              "source": "leechNum"
            },
            "grabs": {
              "source": "completedNum"
            },
            "pubdate": {
              "source": "listingTime",
              "transform": "utc_to_local"
            },
            "downloadvolumefactor": {
              "type": "mapping",
              "source": "downloadPromotion",
              "map": {
                "free": 0.0,
                "half": 0.5,
                "none": 1.0
              }
            },
            "uploadvolumefactor": {
              "type": "mapping",
              "source": "uploadPromotion",
              "map": {
                "one_half": 0.5,
                "double_upload": 2.0,
                "none": 1.0
              }
            },
            "labels": {
              "source": "tagList",
              "transform": "split_map",
              "map": {
                "5": "国语",
                "6": "中字",
                "7": "粤语",
                "8": "英字"
              }
            },
            "page_url": {
              "type": "template",
              "value": "https://{domain}/torrent/{tid}",
              "fields": {
                "tid": "id"
              }
            }
          }
        }
      },
      "test_connection": {
        "method": "POST",
        "path": "/openApi/torrent/fetchOpenTorrentList.json",
        "body": {
          "keyword": "",
          "pageParam": {
            "current": 1,
            "pageSize": 1
          },
          "sorter": {}
        }
      },
      "user_info": {
        "method": "POST",
        "path": "/openApi/user/fetchBasicInfo.json"
      }
    }
  },
  "user_info": {
    "type": "api",
    "profile": {
      "method": "POST",
      "path": "/openApi/user/fetchBasicInfo.json",
      "response": {
        "field_mapping": {
          "userid": {
            "source": "data.id",
            "type": "int"
          },
          "username": {
            "source": "data.name"
          },
          "upload": {
            "source": "data.promotionUploadSize",
            "type": "int"
          },
          "download": {
            "source": "data.promotionDownloadSize",
            "type": "int"
          },
          "bonus": {
            "source": "data.bonus",
            "type": "float"
          },
          "user_level": {
            "source": "data.level",
            "transform": "map_value",
            "map": {
              "1": "Lv.1",
              "2": "Lv.2",
              "3": "Lv.3",
              "4": "Lv.4",
              "5": "Lv.5",
              "6": "Lv.6",
              "7": "Lv.7",
              "8": "Lv.8"
            }
          },
          "join_at": {
            "source": "data.registerTime"
          }
        }
      }
    }
  },
  "download": {
    "type": "api_chained",
    "method": "POST",
    "path": "/openApi/torrent/generateDownloadKey.json?id={tid}",
    "response_key": "data",
    "download_url": "{base}/api/torrent/download1?token={token}"
  },
  "favicon": "data:image/svg+xml;base64,"
}